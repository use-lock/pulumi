{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "pulumi-provider-lock",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "changelog-types": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Bug Fixes",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Refactors",
          "hidden": false
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": false
        },
        {
          "type": "chore",
          "section": "Chores",
          "hidden": false
        }
      ],
      "extra-files": [
        "pulumi-plugin.json",
        {
          "type": "json",
          "path": "schema.json",
          "jsonpath": "$.version"
        },
        "sdk/nodejs/package.json",
        {
          "type": "json",
          "path": "sdk/nodejs/package.json",
          "jsonpath": "$.pulumi.version"
        }
      ]
    }
  }
}
